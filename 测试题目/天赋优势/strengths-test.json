  "questions": [
    {"id":1,"text":"朋友遇到困惑时，总喜欢来找我聊","dim":"connector"},
    {"id":2,"text":"我看待问题的角度，经常和别人不太一样","dim":"observer"},
    {"id":3,"text":"脑海中有很多想法，总想做出点新的东西","dim":"creator"},
    {"id":4,"text":"定了计划不做完，心里就不舒服","dim":"executor"},
    {"id":5,"text":"一群人不知道该怎么办的时候，我往往是第一个站出来拿主意的人","dim":"leader"},
    {"id":6,"text":"我很擅长维持一段长期稳定的关系","dim":"guardian"},
    {"id":7,"text":"我对不了解的领域充满好奇心，总想学点新的","dim":"explorer"},
    {"id":8,"text":"一旦进入状态，我能连续几个小时不受打扰地沉浸在一件事里","dim":"focuser"},
    {"id":9,"text":"换了新环境，我比别人适应得更快","dim":"adaptor"},
    {"id":10,"text":"别人说我讲话有感染力，听完会有动力","dim":"inspirer"},
    {"id":11,"text":"我能察觉到别人情绪的细微变化，即使TA什么都没说","dim":"connector"},
    {"id":12,"text":"别人觉得理所当然的事，我总想多问一句为什么","dim":"observer"},
    {"id":13,"text":"需要创意的时候，我脑子转得比别人快","dim":"creator"},
    {"id":14,"text":"答应的事情，无论如何都会做到","dim":"executor"},
    {"id":15,"text":"我享受站在舞台中央、被人看到的感觉","dim":"leader"},
    {"id":16,"text":"比起冒险，我更愿意把已有的东西经营好","dim":"guardian"},
    {"id":17,"text":"我一个兴趣没学完，又发现了下一个感兴趣的","dim":"explorer"},
    {"id":18,"text":"周围很吵的时候，我还是能专注于手头的事","dim":"focuser"},
    {"id":19,"text":"遇到突发状况，我很少慌，反而觉得是挑战","dim":"adaptor"},
    {"id":20,"text":"帮助别人发现自己的闪光点，是我最有成就感的事","dim":"inspirer"}
